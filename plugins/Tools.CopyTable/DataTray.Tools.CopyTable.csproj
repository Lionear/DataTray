<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DataTray.Tools.CopyTable</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contract only for data access: the tool reads the source table's schema and rows purely through the
         host's IDbProvider, and either runs the CREATE + INSERT on the target (via the picked ToolConnection)
         or hands a script to a query tab there. Private=false keeps Sdk.dll out of the plugin folder so the
         host's copy is used across the ALC boundary. -->
    <ProjectReference Include="..\..\src\DataTray.Sdk\DataTray.Sdk.csproj" Private="false" />
    <!-- Route B: the dialog returns its own Avalonia Control (From → To pickers, segmented options, mode cards),
         so Avalonia is a compile-time reference. ExcludeAssets=runtime — the host owns Avalonia and shares it
         across the plugin ALC boundary. -->
    <PackageReference Include="Avalonia" Version="12.0.5" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reading a table's shape is shared with Schema Diff, source-linked rather than packaged: plugins load
         into isolated ALCs, so a shared DLL would have to be duplicated per plugin folder anyway (or promoted
         into the SDK, whose surface is a public contract). See plugins/Shared.Schema/README.md. -->
    <Compile Include="..\Shared.Schema\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Localization embedded into the main DLL. WithCulture=false stops MSBuild routing the ".nl." file
         to a satellite assembly; LogicalName fixes the resource name the host's PluginLocalizer expects. -->
    <EmbeddedResource Include="Lang\strings.json" LogicalName="Lang/strings.json" WithCulture="false" />
    <EmbeddedResource Include="Lang\strings.nl.json" LogicalName="Lang/strings.nl.json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DataTray.Sdk" />
    <Using Include="DataTray.Sdk.Connections" />
    <Using Include="DataTray.Sdk.Schema" />
    <Using Include="DataTray.Sdk.Query" />
    <Using Include="DataTray.Sdk.Branding" />
    <Using Include="DataTray.Sdk.Localization" />
    <Using Include="DataTray.Sdk.Tools" />
    <Using Include="DataTray.Sdk.Ui" />
    <Using Include="DataTray.Plugins.Schema" />
  </ItemGroup>

</Project>
