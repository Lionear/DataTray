<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Headless drawing only: TreeNodeViewModel touches NodeIcons, whose Geometry.Parse needs a
         render interface to exist. No window is ever created. Same package the Screenshots host uses. -->
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests the App view-models directly. Referencing the App class library pulls Core/Sdk/Avalonia
         transitively; these tests construct view-models only — no controls, and no platform beyond the
         headless drawing stub that HeadlessDrawing sets up for the icon geometries. -->
    <ProjectReference Include="..\..\src\DataTray.App\DataTray.App.csproj" />
  </ItemGroup>

</Project>
