<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DataTray.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="DataTray.App.Views.MainWindow"
        Title="DataTray"
        Icon="/Assets/icon.png"
        Width="1150" Height="740"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        WindowDecorations="BorderOnly">
  <Window.Resources>
    <!-- File ▸ Recent items (SE-154): each RecentFileItem carries its own Open command + path, so the
         menu popup (a separate visual tree) needs no ancestor binding back to the window. -->
    <ControlTheme x:Key="RecentFileItemTheme" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Header" Value="{Binding Display}" />
      <Setter Property="Command" Value="{Binding Open}" />
      <Setter Property="CommandParameter" Value="{Binding Path}" />
      <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
    </ControlTheme>
  </Window.Resources>
  <!-- Window-level shortcuts (Ctrl+K, F5, Ctrl+T, …) are built in code from the live keymap
       (KeymapService) so they can be rebound in Settings › Keyboard without a restart. They live on
       the window, not MainView: with nothing focused yet a keypress lands on the TopLevel itself, so a
       UserControl-level KeyBinding would never see it. See MainWindow.RebuildKeyBindings(). -->

  <!-- macOS gets its menu bar from NativeMenu.Menu below (native, always active regardless of OS —
       Avalonia only surfaces it on macOS); the in-window Menu here is hidden there in code-behind
       so the two never show up stacked on top of each other. -->
  <!-- Mirror the in-window File/Edit/Help menu below. macOS only surfaces top-level NativeMenuItems
       that carry their own submenu as menu-bar entries, so flat items would silently vanish. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="{Binding Loc[MenuFile]}">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="{Binding Loc[NewQueryTab]}" Command="{Binding NewQueryTabCommand}" />
            <!-- Query files (SE-154). The Recent submenu is dynamic and lives in the in-window menu only;
                 native menus don't take an items binding as cleanly. Ctrl+O and drag-drop cover macOS. -->
            <NativeMenuItem Header="{Binding Loc[OpenFileMenu]}" Command="{Binding OpenQueryCommand}" />
            <NativeMenuItem Header="{Binding Loc[SaveQueryMenu]}" Command="{Binding SaveActiveQueryCommand}" />
            <NativeMenuItem Header="{Binding Loc[SaveQueryAsMenu]}" Command="{Binding SaveActiveQueryAsCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{Binding Loc[NewConnectionMenu]}" Command="{Binding NewConnectionCommand}" />
            <NativeMenuItem Header="{Binding Loc[ManageConnections]}" Command="{Binding ManageConnectionsCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{Binding Loc[Exit]}" Command="{Binding ExitCommand}" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <!-- Edit and Help are gone here (SE-278, macOS only): Preferences moved into the DataTray
           app-menu (Cmd+,, App.axaml.cs) — Edit had nothing else in it — and About lives there too,
           so a Help menu holding only About was redundant. Windows/Linux (Menu below) are untouched. -->
      <NativeMenuItem Header="{Binding Loc[MenuTools]}">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="{Binding Loc[QueryLogMenu]}" Command="{Binding OpenQueryLogCommand}" />
            <NativeMenuItem Header="{Binding Loc[PluginStoreMenu]}" Command="{Binding OpenPluginStoreCommand}" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Window.Styles>
    <!-- Caption buttons (SE-291). Full-height, no radius, no border: they are window chrome, not app
         buttons, and every platform draws them that way. The close button is the only one that fills
         with colour on hover — red is what "this one ends the session" looks like everywhere. -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SEHoverBgBrush}" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SESecondaryBgBrush}" />
    </Style>
    <Style Selector="Button.caption.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SEStatusErrorBrush}" />
    </Style>
    <Style Selector="Button.caption.danger:pointerover Path">
      <Setter Property="Stroke" Value="#FFFFFF" />
    </Style>
    <!-- The menu sits on the title bar now, so it may not bring its own surface with it. -->
    <Style Selector="Menu#AppMenu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Window.Styles>

  <!-- OffScreenMargin keeps the content inside the frame when the window is maximised on Windows, where a
       maximised frame deliberately overhangs the work area. -->
  <DockPanel Margin="{Binding $parent[Window].OffScreenMargin}">

    <!-- ===== Our own title bar (SE-291) =====
         `WindowDecorations="BorderOnly"` means nobody else draws one — Avalonia keeps the border, shadow
         and resize grips and we supply the bar. `ElementRole="TitleBar"` hands dragging back to the
         platform: it treats this strip as non-client area, so moving and snapping stay the window
         manager's job rather than something this app reimplements with pointer events.

         The caption buttons must say so themselves (`DecorationsElement`), or the drag area swallows
         their clicks. Double-click is ours, though: with the client area extended, the window manager
         never sees a click here, so the maximise-on-double-click it would normally do never happens.

         macOS is the exception, handled in code-behind: the traffic lights stay (the platform's contract
         — green means full screen, and Mission Control expects them), so there the decorations stay Full
         and our three buttons are hidden. This bar is taller than macOS's own 28 pt, which would leave
         those lights sitting high in it, so MacTitleBar gives the window an empty unified toolbar and
         AppKit centres them. Its menu is already the system menu bar via NativeMenu.Menu, so nothing is
         lost by hiding the in-window one there. -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="38"
            Background="{DynamicResource SESecondaryBgBrush}"
            BorderBrush="{DynamicResource SEHairlineBrush}" BorderThickness="0,0,0,1"
            DoubleTapped="OnTitleBarDoubleTapped"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Panel x:Name="TitleBarContent">

        <StackPanel x:Name="TitleBarLeft" Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Stretch" Spacing="8" Margin="9,0,0,0">
          <Menu x:Name="AppMenu" VerticalAlignment="Center"
                DoubleTapped="OnDecorationsElementDoubleTapped"
                chrome:WindowDecorationProperties.ElementRole="DecorationsElement">
      <MenuItem Header="{Binding Loc[MenuFile]}">
        <MenuItem Header="{Binding Loc[NewQueryTab]}" Command="{Binding NewQueryTabCommand}" />
        <MenuItem Header="{Binding Loc[OpenFileMenu]}" Command="{Binding OpenQueryCommand}" />
        <Separator />
        <MenuItem Header="{Binding Loc[SaveQueryMenu]}" Command="{Binding SaveActiveQueryCommand}" />
        <MenuItem Header="{Binding Loc[SaveQueryAsMenu]}" Command="{Binding SaveActiveQueryAsCommand}" />
        <Separator />
        <!-- Recent files (SE-154): dynamic submenu; each item carries its own Open command + path. -->
        <MenuItem Header="{Binding Loc[RecentFilesMenu]}" ItemsSource="{Binding RecentFiles}"
                  IsEnabled="{Binding HasRecentFiles}"
                  ItemContainerTheme="{StaticResource RecentFileItemTheme}" />
        <MenuItem Header="{Binding Loc[ClearRecentFilesMenu]}" Command="{Binding ClearRecentFilesCommand}"
                  IsEnabled="{Binding HasRecentFiles}" />
        <Separator />
        <MenuItem Header="{Binding Loc[NewConnectionMenu]}" Command="{Binding NewConnectionCommand}" />
        <MenuItem Header="{Binding Loc[ManageConnections]}" Command="{Binding ManageConnectionsCommand}" />
        <Separator />
        <MenuItem Header="{Binding Loc[Exit]}" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Loc[MenuEdit]}">
        <MenuItem Header="{Binding Loc[Preferences]}" Command="{Binding OpenSettingsCommand}" />
      </MenuItem>
      <MenuItem x:Name="ToolsMenu" Header="{Binding Loc[MenuTools]}">
        <MenuItem Header="{Binding Loc[QueryLogMenu]}" Command="{Binding OpenQueryLogCommand}" />
        <MenuItem Header="{Binding Loc[PluginStoreMenu]}" Command="{Binding OpenPluginStoreCommand}" />
        <!-- Plugin-contributed items (SE-164 menu seam) are appended here in code-behind, so the statics
             above keep their live Loc bindings. -->
      </MenuItem>
      <MenuItem Header="{Binding Loc[MenuHelp]}">
        <MenuItem Header="{Binding Loc[About]}" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
          </Menu>
        </StackPanel>

        <!-- Where you are, in the one place the window can always show it: connection, database, object,
             then the app name. The dash only exists to separate the two, so with nothing selected it has
             nothing to separate and goes away with the rest. -->
        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                   Fill="{DynamicResource SEStatusConnectedBrush}"
                   IsVisible="{Binding SelectedConnection, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding CrumbConnection}" FontSize="12.5" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"
                     Foreground="{DynamicResource SETextPrimaryBrush}"
                     IsVisible="{Binding CrumbConnection, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Text="›" FontSize="12.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource SETextFaintBrush}"
                     IsVisible="{Binding ShowDatabaseSeparator}" />
          <TextBlock Text="{Binding CrumbDatabase}" FontSize="12.5" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="200"
                     Foreground="{DynamicResource SETextSecondaryBrush}"
                     IsVisible="{Binding CrumbDatabase, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Text="›" FontSize="12.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource SETextFaintBrush}"
                     IsVisible="{Binding ShowObjectSeparator}" />
          <TextBlock Text="{Binding CrumbObject}" FontSize="12.5" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="260"
                     Foreground="{DynamicResource SETextSecondaryBrush}"
                     IsVisible="{Binding CrumbObject, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Text="—" FontSize="12.5" VerticalAlignment="Center" Margin="3,0,0,0"
                     Foreground="{DynamicResource SETextFaintBrush}"
                     IsVisible="{Binding HasTitleCrumb}" />
          <!-- Mark and wordmark together: one lockup in the middle of the bar, rather than a mark pinned
               to a corner where macOS already keeps its own buttons. -->
          <Image Source="/Assets/icon.png" Width="16" Height="16" VerticalAlignment="Center"
                 Margin="0,0,-1,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="DataTray" FontSize="12.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource SETextSecondaryBrush}" />
        </StackPanel>

        <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    DoubleTapped="OnDecorationsElementDoubleTapped"
                    chrome:WindowDecorationProperties.ElementRole="DecorationsElement">
          <Button Classes="caption" Click="OnMinimiseClick" ToolTip.Tip="{Binding Loc[WindowMinimise]}">
            <Path Width="11" Height="11" Stretch="None" Data="M0,5.5 H11"
                  Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.3" StrokeLineCap="Round" />
          </Button>
          <!-- Glyph and tooltip follow WindowState from code-behind: it is the window's own state, and
               routing it through the view model would be a longer way round to the same two values. -->
          <Button x:Name="MaximiseButton" Classes="caption" Click="OnMaximiseClick">
            <Path x:Name="MaximiseGlyph" Width="11" Height="11" Stretch="None"
                  Data="M0.5,0.5 H10.5 V10.5 H0.5 Z"
                  Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.3" StrokeJoin="Round" />
          </Button>
          <Button Classes="caption danger" Click="OnCloseClick" ToolTip.Tip="{Binding Loc[WindowClose]}">
            <Path Width="11" Height="11" Stretch="None" Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5"
                  Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.3" StrokeLineCap="Round" />
          </Button>
        </StackPanel>
      </Panel>
    </Border>

    <views:MainView x:Name="Body" />
  </DockPanel>
</Window>
