<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DataTray.Infrastructure</RootNamespace>
    <!-- Contains P/Invoke into per-OS credential vaults; only the matching backend runs per platform. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataTray.Core\DataTray.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packaging and updating are the same tool: vpk builds the download and the update feed in one
         step, so the version here and the vpk version in build.yml must match — that is the only
         combination Velopack supports. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
