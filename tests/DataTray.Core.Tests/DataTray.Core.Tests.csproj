<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- The Backends.Docker integration test loads a plugin that implements the IPanelPlugin UI seam, whose
         type metadata references Avalonia. The loader's reflection over that assembly needs Avalonia.Controls
         present at runtime — the host normally provides it across the ALC, so here the test plays that role.
         (No control is instantiated, so no display/AppBuilder is needed.) -->
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataTray.Core\DataTray.Core.csproj" />
    <ProjectReference Include="..\..\src\DataTray.Infrastructure\DataTray.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DataTray.Sdk\DataTray.Sdk.csproj" />
    <!-- Build-only: ensures the Backends.Docker extension plugin is built so the loader integration test can
         discover + ALC-load it from its own output dir. ReferenceOutputAssembly=false keeps it off the test
         assembly's references (it's loaded reflectively, in its own AssemblyLoadContext). -->
    <ProjectReference Include="..\..\plugins\Backends.Docker\DataTray.Backends.Docker.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- For the ScriptDom-based MsSqlFormatter tests (SE-148 phase 2). -->
    <ProjectReference Include="..\..\src\DataTray.Providers.MsSql\DataTray.Providers.MsSql.csproj" />
    <!-- ProviderContainerRecipeTests (SE-176): assert each containerisable engine's declared recipe content
         against the real provider (the recipe is the single source of truth now the Docker built-in table is
         gone). Bundled providers live in src/; the store providers are compiled in from plugins/ for the test. -->
    <ProjectReference Include="..\..\src\DataTray.Providers.MySql\DataTray.Providers.MySql.csproj" />
    <ProjectReference Include="..\..\src\DataTray.Providers.Postgres\DataTray.Providers.Postgres.csproj" />
    <ProjectReference Include="..\..\plugins\Providers.MongoDb\DataTray.Providers.MongoDb.csproj" />
    <ProjectReference Include="..\..\plugins\Providers.Redis\DataTray.Providers.Redis.csproj" />
    <ProjectReference Include="..\..\plugins\Providers.DragonflyDb\DataTray.Providers.DragonflyDb.csproj" />
    <ProjectReference Include="..\..\plugins\Providers.Elasticsearch\DataTray.Providers.Elasticsearch.csproj" />
    <!-- DuckDbBrowseTargetTests (SE-12): the DuckDB provider has to recover a result set's table from the
         query text, because its driver reports no base-table metadata, so that logic is unit-tested.
         ExcludeAssets="native" keeps DuckDB's ~316 MB of per-RID libduckdb binaries out of the test output —
         the tested type is pure string handling and never loads the engine. -->
    <ProjectReference Include="..\..\plugins\Providers.DuckDb\DataTray.Providers.DuckDb.csproj"
                      ExcludeAssets="native" />
    <!-- Also carries ClickHouseScriptTests (SE-36): ClickHouse is the one engine whose provider has to split
         script text itself, so the splitter is unit-tested rather than only exercised through a live server. -->
    <ProjectReference Include="..\..\plugins\Providers.ClickHouse\DataTray.Providers.ClickHouse.csproj" />
    <!-- For the CoreToolProvider tool-handler integration tests (SE-155): exercises the tools' JSON arg
         parsing end-to-end against a real McpHost. -->
    <ProjectReference Include="..\..\src\DataTray.Mcp.Server\DataTray.Mcp.Server.csproj" />
  </ItemGroup>

</Project>