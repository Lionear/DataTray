<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = GUI subsystem on Windows (no console window allocated for this GUI app). On Linux/macOS
         WinExe is identical to Exe — no subsystem distinction — so the AppImage/DMG builds are unaffected. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>DataTray.Desktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <MacBundleName>DataTray</MacBundleName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataTray.App\DataTray.App.csproj" />
  </ItemGroup>

  <!-- Keep the macOS bundle metadata out of the plain build output; the CreateMacAppBundle
       target below copies them into the .app it assembles from the publish output. -->
  <ItemGroup>
    <None Update="Info.plist;app.icns" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- Attribution has to travel with the app, not just live in the repo: the bundled OSS licences
       (MIT/Apache-2.0/…) require the notices to be distributed alongside the binaries. Generated by
       tools/generate-third-party-notices.py; About links to the copy on GitHub (SE-127). -->
  <ItemGroup>
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
  </ItemGroup>

  <!-- Each provider's self-contained output, tagged with the plugin-id folder it belongs in.
       Populated inside a target (not at project scope) because the wildcards must be evaluated
       after the providers have built, not during the initial project evaluation. -->
  <PropertyGroup>
    <!-- Absolute, because it is handed to another project as PublishDir. -->
    <MsSqlPluginPublishDir>$(MSBuildThisFileDirectory)obj\plugin-publish\sqlserver\$(Configuration)\$(RuntimeIdentifier)\</MsSqlPluginPublishDir>
  </PropertyGroup>

  <!--
    The SQL Server provider is staged from a RID-specific publish instead of from bin/, and it is the
    only one that needs to be.

    Microsoft.Data.SqlClient ships its managed assembly once per RID, under
    runtimes/win/lib/net9.0 and runtimes/unix/lib/net9.0, and the plugin's deps.json resolves it
    there — the loader is an AssemblyDependencyResolver, so those paths are load-bearing and the
    folders cannot simply be deleted. But their names contain a dot, and macOS `codesign` treats any
    dotted directory inside a bundle as a nested bundle: it reports "bundle format unrecognized,
    invalid, or unsuitable" and refuses to sign the app at all. Velopack signs recursively, so this
    fails the whole macOS package.

    Publishing for the target RID resolves it the way the SDK intends: the correct SqlClient lands in
    the plugin root and the deps.json written beside it points there, with no runtimes/*/lib tree left.

    Without a RuntimeIdentifier — the plain `dotnet build` dev loop — there is nothing to flatten
    towards and nothing signs that output, so the bin/ copy is kept.
  -->
  <Target Name="PublishMsSqlProviderForStaging" Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\DataTray.Providers.MsSql\DataTray.Providers.MsSql.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;PublishDir=$(MsSqlPluginPublishDir)" />
  </Target>

  <Target Name="CollectProviderPluginFiles" DependsOnTargets="PublishMsSqlProviderForStaging">
    <ItemGroup>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\DataTray.Providers.Postgres\bin\$(Configuration)\$(TargetFramework)\**\*">
        <PluginId>postgres</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\DataTray.Providers.Sqlite\bin\$(Configuration)\$(TargetFramework)\**\*">
        <PluginId>sqlite</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\DataTray.Providers.MySql\bin\$(Configuration)\$(TargetFramework)\**\*">
        <PluginId>mysql</PluginId>
      </ProviderPluginFile>
      <!-- See PublishMsSqlProviderForStaging above for why this one is not staged from bin/. -->
      <ProviderPluginFile Include="$(MsSqlPluginPublishDir)**\*" Condition="'$(RuntimeIdentifier)' != ''">
        <PluginId>sqlserver</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\DataTray.Providers.MsSql\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(RuntimeIdentifier)' == ''">
        <PluginId>sqlserver</PluginId>
      </ProviderPluginFile>
      <!-- Core admin tool plugin, staged unconditionally (Debug + Release) like the providers. -->
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\DataTray.Tools.MsSqlAdmin\bin\$(Configuration)\$(TargetFramework)\**\*">
        <PluginId>mssql-admin</PluginId>
      </ProviderPluginFile>
      <!-- First-party MCP tools plugin, staged unconditionally like the providers/admin tool. -->
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\DataTray.Mcp.Server\bin\$(Configuration)\$(TargetFramework)\**\*">
        <PluginId>datatray-mcp</PluginId>
      </ProviderPluginFile>
      <!-- Debug-only, non-shipped plugins from the repo-root plugins/ folder (see App.csproj). Absent
           from Release/publish staging. Future dev-only tool plugins (plugins/Tools.*) go here too. -->
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Providers.Template\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>template</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Providers.ClickHouse\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>clickhouse</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Providers.DragonflyDb\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>dragonflydb</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Providers.DuckDb\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>duckdb</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Providers.Elasticsearch\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>elasticsearch</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Providers.MongoDb\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>mongodb</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Providers.Redis\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>redis</PluginId>
      </ProviderPluginFile>
      <!-- Cross-connection schema-diff / copy-table tools (SE-99 / SE-100): store-only, Debug-staged for
           development but not bundled in Release — installed from the Plugin Store like the other plugins/ tools. -->
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Tools.SchemaDiff\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>schema-diff</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Tools.ErDiagram\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>er-diagram</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Tools.CopyTable\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>copy-table</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Tools.UniversalBackup\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>universal-backup</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Tools.MsSqlBacpac\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>mssql-bacpac</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Viewers.Basic\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>basic-viewers</PluginId>
      </ProviderPluginFile>
      <ProviderPluginFile Include="$(MSBuildThisFileDirectory)..\..\plugins\Backends.Docker\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Condition="'$(Configuration)' == 'Debug'">
        <PluginId>local-containers</PluginId>
      </ProviderPluginFile>
    </ItemGroup>

    <!-- Drop the native libraries for platforms a desktop build can never run on. SQLitePCLRaw ships
         e_sqlite3 for 31 runtime identifiers — Android, iOS, Mac Catalyst, WebAssembly and the rest —
         and a plugin folder is copied whole, so all of them ended up inside the app.
         Not just weight: on macOS a recursive `codesign` walks into
         plugins/sqlite/runtimes/browser-wasm/nativeassets/net9.0, calls it "bundle format
         unrecognized, invalid, or unsuitable" and refuses the whole bundle. That went unnoticed while
         the old workflow swallowed the signing failure with a trailing `|| echo warning` — so the .app
         was shipping unsealed — and only surfaced once vpk took over the signing and failed on it.
         Desktop RIDs (win-*, linux-*, osx-*) are deliberately left alone: which one is needed depends
         on the publish target, and keeping them costs a few megabytes rather than a broken bundle. -->
    <ItemGroup>
      <ProviderPluginFile
        Remove="@(ProviderPluginFile)"
        Condition="$([System.String]::Copy('%(RecursiveDir)').Replace('\','/').Contains('runtimes/browser-wasm/'))
                Or $([System.String]::Copy('%(RecursiveDir)').Replace('\','/').Contains('runtimes/android-'))
                Or $([System.String]::Copy('%(RecursiveDir)').Replace('\','/').Contains('runtimes/ios-'))
                Or $([System.String]::Copy('%(RecursiveDir)').Replace('\','/').Contains('runtimes/iossimulator-'))
                Or $([System.String]::Copy('%(RecursiveDir)').Replace('\','/').Contains('runtimes/maccatalyst-'))
                Or $([System.String]::Copy('%(RecursiveDir)').Replace('\','/').Contains('runtimes/tvos'))
                Or $([System.String]::Copy('%(RecursiveDir)').Replace('\','/').Contains('runtimes/tizen'))" />
    </ItemGroup>
  </Target>

  <!-- Stage the providers into plugins/<id>/ beside the built executable, so the plugin loader
       discovers them exactly as it would third-party plugins. -->
  <Target Name="StageProviderPlugins" AfterTargets="Build" DependsOnTargets="CollectProviderPluginFiles">
    <Copy SourceFiles="@(ProviderPluginFile)"
          DestinationFiles="@(ProviderPluginFile->'$(TargetDir)plugins\%(PluginId)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Same staging into the publish output. `dotnet publish` does not run the Build-time staging
       into $(PublishDir), so without this a published app (and the macOS bundle below) would ship
       with no database providers at all. -->
  <Target Name="StageProviderPluginsForPublish" AfterTargets="Publish" DependsOnTargets="CollectProviderPluginFiles">
    <Copy SourceFiles="@(ProviderPluginFile)"
          DestinationFiles="@(ProviderPluginFile->'$(PublishDir)plugins\%(PluginId)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Assemble a real macOS .app bundle from the publish output. macOS reads the bold application-menu
       name and Dock title from Contents/Info.plist (CFBundleName); running the loose executable (or
       `dotnet run`) has no bundle, so it falls back to "Avalonia Application". Runs on macOS only,
       after Publish, so `dotnet publish -r osx-arm64` (or osx-x64) produces a launchable bundle.
       Depends on the publish staging so the copied tree already contains plugins/. -->
  <Target Name="CreateMacAppBundle" AfterTargets="Publish"
          DependsOnTargets="StageProviderPluginsForPublish"
          Condition="'$([MSBuild]::IsOSPlatform(`OSX`))' == 'true'">
    <PropertyGroup>
      <MacBundleRoot>$(PublishDir)../$(MacBundleName).app</MacBundleRoot>
      <MacBundleContents>$(MacBundleRoot)/Contents</MacBundleContents>
      <MacBundleExe>$(MacBundleContents)/MacOS</MacBundleExe>
      <MacBundleResources>$(MacBundleContents)/Resources</MacBundleResources>
    </PropertyGroup>
    <RemoveDir Directories="$(MacBundleRoot)" />
    <MakeDir Directories="$(MacBundleExe);$(MacBundleResources)" />
    <ItemGroup>
      <MacPublishedFiles Include="$(PublishDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(MacPublishedFiles)"
          DestinationFiles="@(MacPublishedFiles->'$(MacBundleExe)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="Info.plist" DestinationFiles="$(MacBundleContents)/Info.plist" />
    <Copy SourceFiles="app.icns" DestinationFiles="$(MacBundleResources)/app.icns" />
    <Exec Command="chmod +x &quot;$(MacBundleExe)/$(AssemblyName)&quot;" />
    <Message Importance="high" Text="Created macOS app bundle: $(MacBundleRoot)" />
  </Target>

</Project>
