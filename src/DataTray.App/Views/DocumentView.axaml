<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="DataTray.App.Views.DocumentView">
  <UserControl.Styles>
    <!-- Flat tabs matching the document-tab strip (Theme.axaml TabItem): plain text, no button
         chrome, just an accent underline on the selected one — this is a sibling tab strip
         (one result set of one Run), not a button toolbar, so it should read the same way. -->
    <Style Selector="Button.ResultTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SETextSecondaryBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.ResultTab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SEHoverBgBrush}" />
    </Style>
    <Style Selector="Button.ResultTab.Accent">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SEAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SETextPrimaryBrush}" />
    </Style>

    <!-- The "View" switcher (SE-75): a small segmented control, not tabs — picking Grid/JSON/Image swaps
         the rendering of the *same* result set, where the ResultTab strip beside it picks a different one.
         Reads as a compact toggle group so the two are not mistaken for each other. -->
    <Style Selector="ListBox.ViewSwitcher ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource SEPanelBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SETextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SEHairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SEControlRadius}" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.ViewSwitcher ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SEHoverBgBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource SETextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.ViewSwitcher ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SEAccentBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource SEAccentFgBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="RootGrid" RowDefinitions="Auto,2*,Auto,Auto,Auto,3*,Auto">

    <!-- Row 0: mode-specific toolbar. Query = connection/database switcher + Run/Format; Browse = paging + filter. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                IsVisible="{Binding IsQueryMode}">
      <Button Classes="Accent" Content="{Binding Loc[Run]}" Command="{Binding RunCommand}"
              IsVisible="{Binding !IsRunning}" />
      <!-- Swaps in while a query runs: cancels the in-flight command via its CancellationToken. -->
      <Button Classes="Accent" Content="{Binding Loc[Stop]}" Command="{Binding StopCommand}"
              IsVisible="{Binding IsRunning}" />
      <Button Content="{Binding Loc[RunAtCursor]}" Command="{Binding RunAtCursorCommand}" />
      <Button Content="{Binding Loc[Explain]}" Command="{Binding ExplainCommand}" />
      <Button Content="{Binding Loc[Format]}" Command="{Binding FormatCommand}" />
      <!-- Connection/database switcher (DBeaver-style): pick which saved connection — and which
           database on it — this query tab runs against. Database combo hides itself when the engine
           has no database layer (SQLite: HasDatabasePicker stays false). -->
      <ComboBox MinWidth="160" ItemsSource="{Binding AvailableConnections}"
                SelectedItem="{Binding Connection}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox MinWidth="140" ItemsSource="{Binding AvailableDatabases}"
                SelectedItem="{Binding SelectedDatabase}"
                IsVisible="{Binding HasDatabasePicker}" />
    </StackPanel>

    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding IsBrowseMode}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
        <Button Grid.Column="0" Margin="0,0,6,0"
                Content="{Binding Loc[PrevPage]}" Command="{Binding PrevPageCommand}" />
        <Button Grid.Column="1" Margin="0,0,10,0"
                Content="{Binding Loc[NextPage]}" Command="{Binding NextPageCommand}" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                   FontSize="12" Foreground="{DynamicResource SETextSecondaryBrush}"
                   Text="{Binding RowRange}" />
        <TextBox Grid.Column="3" MinWidth="160"
                 Text="{Binding FilterText}"
                 PlaceholderText="{Binding Loc[Filter]}" />
        <Button Grid.Column="4" Margin="8,0,0,0"
                Content="{Binding Loc[Apply]}" Command="{Binding ApplyFilterCommand}" IsDefault="True" />
      </Grid>

      <!-- Per-column inline filter: one small box per browse-grid column, combined with the free-text
           WHERE box above (AND) on the same Apply command — no separate auto-apply logic needed. -->
      <ItemsControl ItemsSource="{Binding ColumnFilters}"
                    IsVisible="{Binding ColumnFilters.Count}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBox Width="110" Margin="0,0,6,4" Text="{Binding Value}" PlaceholderText="{Binding ColumnName}"
                     KeyDown="OnColumnFilterKeyDown" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Row 0 (monitor): manual Refresh + auto-refresh interval. The grid below is the live sessions list. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                VerticalAlignment="Center" IsVisible="{Binding IsMonitorMode}">
      <Button Content="{Binding Loc[Refresh]}" Command="{Binding RefreshMonitorCommand}" />
      <TextBlock Text="{Binding Loc[AutoRefresh]}" VerticalAlignment="Center"
                 Foreground="{DynamicResource SETextSecondaryBrush}" />
      <ComboBox MinWidth="90" ItemsSource="{Binding RefreshOptions}"
                SelectedItem="{Binding SelectedRefreshOption}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <!-- Row 1: SQL editor (query mode only; the row is collapsed for browse in code-behind). -->
    <Border Grid.Row="1" IsVisible="{Binding IsQueryMode}"
            Background="{DynamicResource SEWindowBgBrush}"
            BorderBrush="{DynamicResource SEHairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource SEControlRadius}" ClipToBounds="True">
      <ae:TextEditor x:Name="SqlEditor"
                     ShowLineNumbers="True"
                     WordWrap="{Binding EditorWordWrap}"
                     Padding="4"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace">
        <ae:TextEditor.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding Loc[Cut]}" Click="OnEditorCutClick" />
            <MenuItem Header="{Binding Loc[Copy]}" Click="OnEditorCopyClick" />
            <MenuItem Header="{Binding Loc[Paste]}" Click="OnEditorPasteClick" />
            <MenuItem Header="{Binding Loc[SelectAll]}" Click="OnEditorSelectAllClick" />
            <Separator />
            <MenuItem Header="{Binding Loc[GenerateGuid]}">
              <MenuItem Header="{Binding Loc[GuidV4]}" Click="OnGenerateGuidV4Click" />
              <MenuItem Header="{Binding Loc[GuidV7]}" Click="OnGenerateGuidV7Click" />
            </MenuItem>
          </ContextMenu>
        </ae:TextEditor.ContextMenu>
      </ae:TextEditor>
    </Border>

    <!-- Row 2 is intentionally empty (Auto → 0 height): execution outcomes now surface only in the
         host's Output panel, not inline under the editor. -->

    <!-- Row 3: edit toolbar + pending-changes bar (shared by both modes). Equal space above and below. -->
    <Grid Grid.Row="3" Margin="0,8,0,8"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
          IsVisible="{Binding ShowEditToolbar}">
      <Button Grid.Column="0" Margin="0,0,8,0"
              Content="{Binding Loc[AddRow]}" Command="{Binding AddRowCommand}" />
      <Button Grid.Column="1" Margin="0,0,8,0"
              Content="{Binding Loc[DeleteRow]}" Command="{Binding DeleteRowCommand}" />
      <Button Grid.Column="2" Margin="0,0,8,0" Classes="Accent"
              Content="{Binding Loc[Save]}" Command="{Binding SaveCommand}" />
      <Button Grid.Column="3" Classes="Subtle" Margin="0,0,8,0"
              Content="{Binding Loc[Discard]}" Command="{Binding DiscardCommand}" />
      <Button Grid.Column="4" x:Name="ExportButton" Click="OnExportClick"
              Content="{Binding Loc[Export]}" />
      <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="12,0,0,0"
                 Foreground="{DynamicResource SETextSecondaryBrush}"
                 Text="{Binding PendingSummary}" />
      <TextBlock Grid.Column="6" VerticalAlignment="Center"
                 Foreground="{DynamicResource SETextFaintBrush}"
                 Text="{Binding ReadOnlyReason}"
                 IsVisible="{Binding ReadOnlyReason, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
    </Grid>

    <!-- Row 4: result-set tab strip (left) + the "View" switcher (right, SE-75). The row carries two
         independent things now, so it shows when *either* has something to say: the tab strip only for a
         multi-statement/multi-resultset run or Explain, the switcher whenever a viewer plugin applies. -->
    <Grid Grid.Row="4" Margin="0,0,0,6" ColumnDefinitions="Auto,*,Auto">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static conv:BoolConverters.Or}">
          <Binding Path="HasMultipleResultSets" />
          <Binding Path="HasViewSwitcher" />
        </MultiBinding>
      </Grid.IsVisible>

      <ItemsControl Grid.Column="0" ItemsSource="{Binding ResultSets}"
                    IsVisible="{Binding HasMultipleResultSets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="ResultTab" Classes.Accent="{Binding IsSelected}" Content="{Binding Label}"
                    Command="{Binding $parent[ItemsControl].DataContext.SelectResultSetCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                  IsVisible="{Binding HasViewSwitcher}">
        <TextBlock Text="{Binding Loc[ViewLabel]}" VerticalAlignment="Center"
                   FontSize="11.5" Foreground="{DynamicResource SETextFaintBrush}" />
        <ListBox ItemsSource="{Binding AvailableViews}" SelectedItem="{Binding SelectedView}"
                 Classes="ViewSwitcher" Background="Transparent" BorderThickness="0" Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" FontSize="11.5" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>

    <!-- Row 5: the result surface — the editable grid, or a viewer's control in its place (SE-75). The two
         swap on visibility rather than both being mounted, so a viewer never runs behind the grid. -->
    <Border Grid.Row="5"
            IsVisible="{Binding !IsGridView}"
            BorderBrush="{DynamicResource SEHairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource SEControlRadius}" ClipToBounds="True">
      <ContentControl x:Name="ViewerHost" />
    </Border>

    <Border Grid.Row="5"
            IsVisible="{Binding IsGridView}"
            BorderBrush="{DynamicResource SEHairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource SEControlRadius}" ClipToBounds="True">
      <DataGrid x:Name="ResultsGrid"
                AutoGenerateColumns="False"
                IsReadOnly="{Binding !IsResultEditable}"
                SelectedItem="{Binding SelectedRow}"
                SelectionMode="Extended"
                HeadersVisibility="All"
                CanUserResizeColumns="True">
        <DataGrid.ContextMenu>
          <!-- Copies the current selection, or the whole result set if nothing is selected — same
               source/fallback as the "Export…" button, just to the clipboard instead of a file. -->
          <ContextMenu Opening="OnGridContextMenuOpening">
            <!-- Monitor row actions: Kill is always offered (hard), Cancel only where the engine has a
                 soft variant (Postgres/MySQL). Both get disabled on the monitor's own session in the
                 Opening handler so the polling tab can't shoot itself down. -->
            <MenuItem x:Name="KillSessionItem" Header="{Binding Loc[KillSession]}" Click="OnKillSessionClick"
                      IsVisible="{Binding IsMonitorMode}" />
            <MenuItem x:Name="CancelQueryItem" Header="{Binding Loc[CancelQuery]}" Click="OnCancelQueryClick"
                      IsVisible="{Binding MonitorSupportsCancel}" />
            <Separator IsVisible="{Binding IsMonitorMode}" />
            <MenuItem Header="{Binding Loc[SetNull]}" Click="OnSetNullClick"
                      IsVisible="{Binding IsResultEditable}" />
            <MenuItem Header="{Binding Loc[SetEmpty]}" Click="OnSetEmptyClick"
                      IsVisible="{Binding IsResultEditable}" />
            <MenuItem Header="{Binding Loc[GenerateGuid]}" IsVisible="{Binding IsResultEditable}">
              <MenuItem Header="{Binding Loc[GuidV4]}" Click="OnGridGuidV4Click" />
              <MenuItem Header="{Binding Loc[GuidV7]}" Click="OnGridGuidV7Click" />
            </MenuItem>
            <MenuItem Header="{Binding Loc[CopyCell]}" Click="OnCopyCellClick" />
            <MenuItem Header="{Binding Loc[Copy]}" Click="OnCopyClick" />
            <MenuItem Header="{Binding Loc[CopyWithHeaders]}" Click="OnCopyWithHeadersClick" />
            <Separator />
            <MenuItem Header="{Binding Loc[CopyAsCsv]}" Click="OnCopyAsCsvClick" />
            <MenuItem Header="{Binding Loc[CopyAsMarkdown]}" Click="OnCopyAsMarkdownClick" />
            <MenuItem Header="{Binding Loc[CopyAsHtml]}" Click="OnCopyAsHtmlClick" />
            <MenuItem Header="{Binding Loc[CopyAsInsert]}" Click="OnCopyAsInsertClick" />
          </ContextMenu>
        </DataGrid.ContextMenu>
      </DataGrid>
    </Border>

    <!-- Row 6: query-result paging nav (SE-178) — under the grid, DataGrip/DBeaver-style. Browse has its own
         paging bar on top (with the filter box); this is the query-mode counterpart, prev/next + row range. -->
    <Grid Grid.Row="6" ColumnDefinitions="Auto,Auto,Auto" Margin="0,6,0,0">
      <!-- Hidden behind a viewer: the paging nav belongs to the grid, and a viewer owns the whole area. -->
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
          <Binding Path="IsQueryPaged" />
          <Binding Path="IsGridView" />
        </MultiBinding>
      </Grid.IsVisible>
      <Button Grid.Column="0" Margin="0,0,6,0"
              Content="{Binding Loc[PrevPage]}" Command="{Binding PrevPageCommand}" />
      <Button Grid.Column="1" Margin="0,0,10,0"
              Content="{Binding Loc[NextPage]}" Command="{Binding NextPageCommand}" />
      <TextBlock Grid.Column="2" VerticalAlignment="Center"
                 FontSize="12" Foreground="{DynamicResource SETextSecondaryBrush}"
                 Text="{Binding RowRange}" />
    </Grid>
  </Grid>
</UserControl>
