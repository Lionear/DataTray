<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SqlExplorer.App.App">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <!-- Lionear tokens + control styling; last so it overrides the Fluent defaults above. -->
    <StyleInclude Source="avares://SqlExplorer.App/Styles/Theme.axaml" />
    <!-- After Theme.axaml: the calendar's header buttons have to beat the generic Button style there. -->
    <StyleInclude Source="avares://SqlExplorer.App/Styles/Calendar.axaml" />
  </Application.Styles>
</Application>
