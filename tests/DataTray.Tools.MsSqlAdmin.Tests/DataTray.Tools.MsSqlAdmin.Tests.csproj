<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin declares Avalonia with ExcludeAssets=runtime — the host owns it and shares it across the
         ALC boundary, so the plugin must not ship its own copy. A test process has no host, so merely
         constructing a tool that names a Control (IndexToolBase.CreateView) fails to load Avalonia.Controls.
         Referenced here with runtime assets so the assembly is on disk for the test run only. -->
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pure logic behind this plugin's tools: the Activity Monitor's rate arithmetic, its
         blocking-chain and wait-category rules, and the index statements. No server, no host. -->
    <ProjectReference Include="..\..\src\DataTray.Tools.MsSqlAdmin\DataTray.Tools.MsSqlAdmin.csproj" />
  </ItemGroup>

</Project>
