<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:DataTray.App.Converters"
             xmlns:vm="using:DataTray.App.ViewModels"
             x:Class="DataTray.App.Views.ConnectionListView">
  <!-- SE-289: the connection/folder tree that used to be the left half of the Connection Manager
       *window*. It now takes over the main window's sidebar while connection management is active —
       the other state of that same column, not a second tree beside it. Drag & drop (reparent +
       reorder) lives in the code-behind, unchanged from the window. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Same row shape as the sidebar's normal "Connections" header, so switching states doesn't move
         anything: a title on the left, one button on the right. This one leaves manage-mode and hands
         the column back to the schema tree. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,8,6,2">
      <TextBlock Grid.Column="0" Text="{Binding Loc[ManageConnections]}"
                 FontWeight="Bold" FontSize="12"
                 Foreground="{DynamicResource SETextSecondaryBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="Subtle" Padding="6,4"
              ToolTip.Tip="{Binding Loc[CloseManager]}"
              Command="{Binding CloseCommand}">
        <!-- 14px / 1.4, same as the toolbar icons below and as the browse state's header button. -->
        <Path Width="14" Height="14" Stretch="Uniform" Data="{x:Static vm:NodeIcons.ClearFilter}"
              Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.4"
              StrokeJoin="Round" StrokeLineCap="Round" />
      </Button>
    </Grid>

    <!-- Toolbar: filter + add/duplicate/delete -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="8,6,8,6">
      <!-- Same shape as the schema tree's filter in the other state of this column: glass on the left,
           clear cross on the right, accent ring while it is actually narrowing the list. -->
      <TextBox Grid.Column="0" Text="{Binding Filter}"
               Classes.Filtering="{Binding HasFilter}"
               PlaceholderText="{Binding Loc[FilterConnections]}">
        <TextBox.InnerLeftContent>
          <Path Width="12" Height="12" Stretch="Uniform" Margin="7,0,2,0"
                VerticalAlignment="Center" Data="{x:Static vm:NodeIcons.Search}"
                Stroke="{DynamicResource SETextFaintBrush}" StrokeThickness="1.6"
                StrokeJoin="Round" StrokeLineCap="Round" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Button Classes="Subtle" Padding="5,4" Margin="0,0,3,0"
                  IsVisible="{Binding HasFilter}"
                  ToolTip.Tip="{Binding Loc[ClearFilter]}"
                  Command="{Binding ClearFilterCommand}">
            <Path Width="10" Height="10" Stretch="Uniform" Data="{x:Static vm:NodeIcons.ClearFilter}"
                  Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.6"
                  StrokeJoin="Round" StrokeLineCap="Round" />
          </Button>
        </TextBox.InnerRightContent>
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Escape" Command="{Binding ClearFilterCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Classes="Subtle" Margin="4,0,0,0" Padding="7,5"
              ToolTip.Tip="{Binding Loc[NewConnection]}"
              Command="{Binding NewConnectionCommand}">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{x:Static vm:NodeIcons.Plus}"
              Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.4"
              StrokeJoin="Round" StrokeLineCap="Round" />
      </Button>
      <Button Grid.Column="2" Classes="Subtle" Padding="7,5"
              ToolTip.Tip="{Binding Loc[NewFolder]}"
              Command="{Binding NewFolderCommand}">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{x:Static vm:NodeIcons.FolderPlus}"
              Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.4"
              StrokeJoin="Round" StrokeLineCap="Round" />
      </Button>
      <Button Grid.Column="3" Classes="Subtle" Padding="7,5"
              ToolTip.Tip="{Binding Loc[DuplicateConnection]}"
              Command="{Binding DuplicateConnectionCommand}">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{x:Static vm:NodeIcons.Duplicate}"
              Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.4"
              StrokeJoin="Round" StrokeLineCap="Round" />
      </Button>
      <Button Grid.Column="4" Classes="Subtle" Padding="7,5"
              ToolTip.Tip="{Binding Loc[Delete]}"
              Command="{Binding DeleteConnectionCommand}">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{x:Static vm:NodeIcons.Trash}"
              Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.4"
              StrokeJoin="Round" StrokeLineCap="Round" />
      </Button>
      <!-- Import from DataGrip/DBeaver (SE-233); it lived on the retired window's toolbar and keeps its
           place among the other connection-level actions. -->
      <Button Grid.Column="5" Classes="Subtle" Padding="7,5"
              ToolTip.Tip="{Binding Loc[ImportConnectionsTitle]}"
              Command="{Binding ImportExternalCommand}">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{x:Static vm:NodeIcons.ImportConnections}"
              Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.4"
              StrokeJoin="Round" StrokeLineCap="Round" />
      </Button>
    </Grid>

    <TreeView Grid.Row="2" x:Name="ConnectionTree" Padding="4,0,4,4"
              ItemsSource="{Binding Nodes}"
              SelectedItem="{Binding SelectedNode}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <!-- Identical to the schema tree's rows in MainView. This used to be a 960x640 window of its
               own where roomier rows were fine; now both trees take turns in the same 280px column, and
               a 2px difference in row pitch is the whole reason the manage state read as "bigger". -->
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="MinHeight" Value="22" />
          <Setter Property="Padding" Value="4,1" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}">
          <!-- Background carries the drop-target highlight (see ConnectionManagerNode.DropBrush).
               Insert-line indicators (Before/After) sit at the top/bottom edge as a 2px accent bar. -->
          <Border Background="{Binding DropBrush}" CornerRadius="3" Padding="2,0"
                  BorderBrush="{DynamicResource SEAccentBrush}"
                  BorderThickness="{Binding IsInsertBefore, Converter={x:Static conv:InsertLineThicknessConverter.Top}}">
            <Border BorderBrush="{DynamicResource SEAccentBrush}"
                    BorderThickness="{Binding IsInsertAfter, Converter={x:Static conv:InsertLineThicknessConverter.Bottom}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Connection colour flag (prod = red). -->
                <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                        Background="{Binding ColorBrush}" IsVisible="{Binding HasColor}" />
                <Image Width="16" Height="16" VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       Source="{Binding IconImage}" IsVisible="{Binding HasImageIcon}" />
                <!-- 12px, not 16: the schema tree draws its vector icons at 12 and a provider's brand
                     image at 16, so the two states line up glyph for glyph. -->
                <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                      Data="{Binding IconGeometry}"
                      Stroke="{DynamicResource SETextSecondaryBrush}" StrokeThickness="1.3"
                      StrokeJoin="Round" StrokeLineCap="Round"
                      IsVisible="{Binding HasVectorIcon}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ConnectionCount}" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource SETextFaintBrush}"
                           IsVisible="{Binding IsFolder}" />
              </StackPanel>
            </Border>
          </Border>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <Border Grid.Row="3" BorderBrush="{DynamicResource SEHairlineBrush}" BorderThickness="0,1,0,0"
            Padding="10,6">
      <TextBlock Text="{Binding Summary}" FontSize="11"
                 Foreground="{DynamicResource SETextFaintBrush}" />
    </Border>
  </Grid>
</UserControl>
